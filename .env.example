# Development defaults (these can be left unset on your own computer)
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=America/Jamaica
LIVECHAT_ALLOW_ANONYMOUS=1
LIVECHAT_QUESTION_COOLDOWN_SECONDS=30

# For deployment: set DJANGO_DEBUG=0 and configure these properly:
# DJANGO_SECRET_KEY=generate-a-random-long-secret-key
# DJANGO_ALLOWED_HOSTS=yourdomain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.example
# DJANGO_SECURE_SSL_REDIRECT=1
